NODE_ENV="development"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecommerce"
PORT=3000
CORS_ORIGIN="http://localhost:5173"
TRUST_PROXY=false
COOKIE_SECURE=false

JWT_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
# Obrigatoria em producao; gere uma chave aleatoria diferente do JWT_SECRET.
QUICK_SALE_CPF_HASH_SECRET="replace-with-a-different-random-secret-of-at-least-32-characters"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_DAYS=7

# Recuperacao de senha por e-mail (Resend). Em desenvolvimento, pode ficar vazio.
RESEND_API_KEY=""
# Remetente verificado no Resend, por exemplo: Vitrine <contato@seudominio.com>
EMAIL_FROM=""
# Daemon ClamAV acessivel apenas pela rede privada do backend. Em desenvolvimento pode ficar vazio.
CLAMAV_HOST=""
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000

MERCADO_PAGO_ACCESS_TOKEN=""
MERCADO_PAGO_WEBHOOK_SECRET=""
PRO_MONTHLY_PRICE=25
FRONTEND_URL="http://localhost:5173"
API_PUBLIC_URL="https://api.seu-dominio.com"
# O checkout Pro envia notificacoes de preapproval e cobrancas recorrentes para:
# https://api.seu-dominio.com/seller/subscription/mercado-pago/webhook
# URL do seu gateway/contrato dos Correios que recebe {fromPostalCode,toPostalCode,items}
# e retorna {service,price,deliveryDays}. Nunca use valor fixo de frete em producao.
CORREIOS_QUOTE_URL=""
CORREIOS_API_TOKEN=""
CHECKOUT_HOLD_MINUTES=30
PLATFORM_FEE_PERCENT=5
ADMIN_WITHDRAWAL_EMAIL="pc00555c@gmail.com"
STORAGE_DRIVER="local"
# Para producao use s3 e preencha os campos abaixo (Cloudflare R2 e compativel).
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""
