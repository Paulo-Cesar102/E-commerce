NODE_ENV="development"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecommerce"
PORT=3000
CORS_ORIGIN="http://localhost:5173"
TRUST_PROXY=false
COOKIE_SECURE=false

JWT_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_DAYS=7

MERCADO_PAGO_ACCESS_TOKEN=""
MERCADO_PAGO_WEBHOOK_SECRET=""
# URL do seu gateway/contrato dos Correios que recebe {fromPostalCode,toPostalCode,items}
# e retorna {service,price,deliveryDays}. Nunca use valor fixo de frete em producao.
CORREIOS_QUOTE_URL=""
CORREIOS_API_TOKEN=""
CHECKOUT_HOLD_MINUTES=30
PLATFORM_FEE_PERCENT=5
ADMIN_WITHDRAWAL_EMAIL="pc00555c@gmail.com"
STORAGE_DRIVER="local"
# Para producao use s3 e preencha os campos abaixo (Cloudflare R2 e compativel).
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""
